# Agent tooling — local to a contributor's machine, not part of the registry
.claude/
CLAUDE.md
.cursor/
.aider*
.agents/
.github/copilot-instructions.md

# ...except the Codex marketplace manifest, which is a published artifact of
# this registry rather than somebody's local tooling. `.agents/` was ignored
# long before #98 put a manifest under it, so the file was generated, checked,
# and silently never committed — leaving `codex plugin marketplace add` finding
# nothing, which is the bug #98 existed to fix. Un-ignore the directory first;
# git will not look inside an ignored one.
!.agents/
!.agents/plugins/
!.agents/plugins/marketplace.json

# Internal working notes
/notes/
/private/
/scratch/
*.draft.md
*.internal.md

# Build output — regenerated by scripts/build_index.py
/site/dist/
findings.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node, if the site build ever needs it
node_modules/
.cache/

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Secrets — nothing in this repository should ever need one
.env
.env.*
*.pem
*.key

# Internal working material — research provenance, planning, outreach.
# Kept locally; not part of what makes the exchange useful to anyone else.
/internal/

# Vite build output and deps
/site/dist/
/site/public/data/
/site/node_modules/

# TS incremental build info
*.tsbuildinfo

# npm workspace root
/node_modules/
/validator/node_modules/
